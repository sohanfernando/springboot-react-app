# Copy to backend/.env and fill in. That file is ignored by git; never commit it.

# MySQL login for the local userDB database
DB_USERNAME=root
DB_PASSWORD=

# Stripe secret key (sk_test_...). Must be from the same Stripe account as
# VITE_STRIPE_PUBLISHABLE_KEY in frontend/.env.
STRIPE_SECRET_KEY=

# Signs login tokens. At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=

# Optional: creates the first administrator at startup if this email is not
# registered yet. The password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: comma-separated browser origins allowed to call the API.
# Defaults to http://localhost:5173.
CORS_ALLOWED_ORIGINS=
